# Production Environment Variables for Railway

# Spotify API Credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Application URLs (update these with your actual domains)
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-app.up.railway.app
REDIRECT_URI=https://your-app.up.railway.app/api/auth/callback

# Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_secret_here

# Port (Railway will set this automatically)
PORT=3000

# Database (Railway PostgreSQL - these will be auto-populated by Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Node Environment
NODE_ENV=production
